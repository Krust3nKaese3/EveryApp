{
  "cli": {
    "version": ">= 6.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_GITHUB_CLIENT_ID": "Ov23liZBUKxpmryUJW1a"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GITHUB_CLIENT_ID": "Ov23liZBUKxpmryUJW1a"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GITHUB_CLIENT_ID": "Ov23liZBUKxpmryUJW1a"
      }
    },
    "production-play": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_GITHUB_CLIENT_ID": "Ov23liZBUKxpmryUJW1a"
      }
    },
    "production-catalog": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "CATALOG_ONLY": "1",
        "EXPO_PUBLIC_CATALOG_ONLY": "1",
        "EXPO_PUBLIC_GITHUB_CLIENT_ID": "Ov23liZBUKxpmryUJW1a"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "{{PLAY_SERVICE_ACCOUNT_JSON}}"
      }
    },
    "production-play": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "{{PLAY_SERVICE_ACCOUNT_JSON}}"
      }
    }
  }
}

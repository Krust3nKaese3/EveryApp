<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <application>
    <service
      android:name="expo.modules.backgroundservice.EveryAppBackgroundService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
    <service
      android:name="expo.modules.backgroundservice.MacroHeadlessTaskService"
      android:enabled="true"
      android:exported="false" />
    <!-- ACL_CONNECTED/DISCONNECTED are on Android's implicit-broadcast exemption list, so this fires even when the app is closed -->
    <receiver
      android:name="expo.modules.backgroundservice.MacroTriggerReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
        <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
      </intent-filter>
    </receiver>
    <receiver
      android:name="expo.modules.backgroundservice.BootReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <service
      android:name="expo.modules.backgroundservice.EveryAppTile1"
      android:label="EveryApp 1"
      android:icon="@android:drawable/ic_media_play"
      android:exported="true"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <service
      android:name="expo.modules.backgroundservice.EveryAppTile2"
      android:label="EveryApp 2"
      android:icon="@android:drawable/ic_media_play"
      android:exported="true"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <service
      android:name="expo.modules.backgroundservice.EveryAppTile3"
      android:label="EveryApp 3"
      android:icon="@android:drawable/ic_media_play"
      android:exported="true"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <service
      android:name="expo.modules.backgroundservice.EveryAppTile4"
      android:label="EveryApp 4"
      android:icon="@android:drawable/ic_media_play"
      android:exported="true"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <service
      android:name="expo.modules.backgroundservice.EveryAppTile5"
      android:label="EveryApp 5"
      android:icon="@android:drawable/ic_media_play"
      android:exported="true"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
  </application>
</manifest>
